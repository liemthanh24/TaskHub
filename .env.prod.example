APP_NAME=TaskHub API (Prod)
APP_VERSION=0.3.0
APP_ENV=prod
DEBUG=false
# Bắt buộc: DATABASE_URL trỏ tới database thật (không được dùng SQLite mặc định)
DATABASE_URL=postgresql+asyncpg://taskhub:taskhub@localhost:5432/taskhub
LOG_LEVEL=INFO
CORS_ORIGINS=https://app.example.com
# Bắt buộc: thay JWT_SECRET bằng giá trị bí mật mạnh, không dùng default
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com
# Bắt buộc: đặt ADMIN_PASSWORD
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
REDIS_URL=redis://localhost:6379/0
